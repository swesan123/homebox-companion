# ============================================================================
# Homebox + Companion stack - copy to .env and fill in.
# ============================================================================

# --- Homebox ----------------------------------------------------------------
# Secret used by Homebox 0.26 to hash API keys (at least 32 bytes). Generate once:
#   openssl rand -base64 48
# Keep it stable. This is Homebox's setting, not Companion's.
HBOX_AUTH_API_KEY_PEPPER=replace-me-with-output-of-openssl-rand-base64-48

# Set to false after you have created your account (then `docker compose up -d`).
HBOX_OPTIONS_ALLOW_REGISTRATION=true

# Max upload size in MB.
HBOX_WEB_MAX_UPLOAD_SIZE=50

# --- Companion: LLM (Google Gemini) ------------------------------------------
# Google AI Studio key: https://aistudio.google.com/apikey
HBC_LLM_API_KEY=replace-me-with-google-ai-studio-key
# Primary model. Fallback (Gemini 3.8 Flash) is configured in Companion Settings.
HBC_LLM_MODEL=gemini/gemini-4-argon

# --- Companion: Homebox connection --------------------------------------------
# Homebox API key (Homebox -> Profile -> API keys, starts with hb_). Create it
# after first run, then `docker compose up -d` to restart Companion.
# Everyone who can reach Companion acts as this key's Homebox user.
HBC_HOMEBOX_API_KEY=

# URL your phone uses to reach Homebox (used for links, e.g. via Tailscale Serve).
HBC_LINK_BASE_URL=https://your-host.your-tailnet.ts.net:8443

# --- Companion: container intake ---------------------------------------------
# Upload the captured photos once to the scanned container.
HBC_CONTAINER_INTAKE_PHOTOS=true
# Keep per-item photos on newly created items.
HBC_SKIP_ITEM_PHOTOS=false

# --- Companion: AI naming and grouping -----------------------------------------
# Values with commas or quotes are wrapped in single quotes so Compose and
# dotenv parsers keep them intact. The name instruction must not start with
# "[Type]", otherwise it is treated as the default format.
HBC_AI_NAME='Descriptive Title Case name: item type first, then the distinguishing visual attributes you can see (color, size or length estimate, brand, connector or form type, material). Never use a generic name like "Cable" or "Battery" when attributes are visible'
HBC_AI_NAMING_EXAMPLES='"Yellow Coiled 3.5mm Audio Aux Cord", "AA Battery", "Black USB-C to USB-A Cable 1M", "Red Handle Phillips Screwdriver PH2"'
HBC_AI_QUANTITY='Group identical items into ONE entry and set quantity to the number visible (4 loose AA batteries = name "AA Battery", quantity 4). Only create separate entries for different variants (different color, size, brand or model)'
